{
  "name": "railhouse",
  "version": "0.1.0",
  "private": true,
  "description": "Railhouse — Casino Rail PoC (demo frontend + sandbox API)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "build": "npm run build -w web",
    "start": "tsx server/index.ts",
    "dev:api": "npm run dev -w casino-rail-api",
    "dev:web": "npm run dev -w casino-rail-demo",
    "deposit-detect": "npm run deposit-detect -w casino-rail-api",
    "withdraw-policy-demo": "npm run withdraw-policy-demo -w casino-rail-api",
    "typecheck": "npm run typecheck -w casino-rail-api"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
